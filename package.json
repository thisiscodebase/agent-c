{
  "name": "agent-c",
  "version": "0.0.0",
  "description": "🍊 Agent C — an internal lookup-and-synthesis assistant for CodeBase, built with Eve, Next.js, and Better Auth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thisiscodebase/agent-c"
  },
  "bugs": {
    "url": "https://github.com/thisiscodebase/agent-c/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test shared/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/seeds/00_multi_user.sql -f supabase/seed.sql",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@flags-sdk/vercel": "^1.4.6",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@shadcn/react": "^0.2.1",
    "@shikijs/langs": "^4.4.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/connect": "0.6.0",
    "ai": "^7.0.44",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.29.5",
    "flags": "^4.2.4",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "0.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "microsandbox": "^0.6.8",
    "react-doctor": "^0.9.2",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.9"
  }
}
