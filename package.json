{
  "name": "agent-c",
  "version": "0.0.0",
  "description": "🍊 Agent C — an internal lookup-and-synthesis assistant for CodeBase, built with Eve, Next.js, and Better Auth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thisiscodebase/agent-c"
  },
  "bugs": {
    "url": "https://github.com/thisiscodebase/agent-c/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.13.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test shared/**/*.test.ts lib/**/*.test.ts lib/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/seeds/00_multi_user.sql -f supabase/seed.sql",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@flags-sdk/vercel": "^1.5.1",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@shadcn/react": "^0.3.1",
    "@shikijs/langs": "^4.5.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.104.3",
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.141",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eve": "^0.82.0",
    "flags": "^4.3.1",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.12.2",
    "motion": "^14.2.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "0.3.2",
    "unpdf": "^1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "microsandbox": "0.6.10",
    "react-doctor": "^0.9.18",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.13"
  }
}
